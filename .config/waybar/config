{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passtrough": false,
    "gtk-layer-shell": true,
    "spacing": 10,
    "margin-top": 3,
    "modules-left": [
        // "custom/text",
        "hyprland/workspaces",
        "tray",
        "mpris"
    ],
    "modules-center": [],
    "modules-right": [
        "cpu",
        "memory",
        "clock"
    ],
    "custom/text": {
        "format": "GRIM"
    },
    "hyprland/workspaces": {
        "active-only": false,
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "focused": "",
            "default": ""
        }
    },
    "tray": {
        "icon-size": 16,
        "show-passive-items": true,
        "spacing": 7,
        "reverse-direction": true
    },
    "mpris": {
        "title-len": 35,
        "interval": 1,
        "album-len": 40,
        "max-len": 35,
        "format": "󰎇 {artist} - {title}",
        "format-paused": "󰏤 Paused"
    },
    "cpu": {
        "interval": 1,
        "format": "cpu <span color='#949292'>{usage}% {icon}</span>",
        "tooltip": true,
        "format-icons": [
            "░░░░░░░░", "█░░░░░░░", "██░░░░░░", "███░░░░░",
            "████░░░░", "█████░░░", "██████░░"
        ]
    },
    "memory": {
        "interval": 20,
        "format": "mem <span color='#949292'>{used:0.1f}Gi/{total:0.1f}Gi {icon}</span>",
        "tooltip-format": "MEM_TOT: {total}GiB\nSWP_TOT: {swapTotal}GiB\n\nMEM_USD: {used:0.1f}GiB\nSWP_USD: {swapUsed:0.1f}GiB",
        "format-icons": [
            "░░░░░░░░", "█░░░░░░░", "██░░░░░░", "███░░░░░",
            "████░░░░", "█████░░░", "██████░░"
        ]
    },
    "clock": {
        "interval": 1,
        "format": "time <span color='#949292'>{0:%H:%M:%S %d-%m-%y}</span>",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "on-scroll": 1,
            "format": {
                "months": "<span size='14pt'>{}\n</span>",
                "days": "<span size='14pt'>{}</span>",
                "weeks": "<span size='14pt'>{}</span>",
                "weekdays": "<span size='14pt'>{}</span>",
                "today": "<span color='#404042'><u>{}</u></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 15
        },
        "format": "batt <span color='#949292'>{capacity}%</span>",
        "interval": 5,
        "format-charging": "BAT: [ {icon} ] <span size='8pt'>CHRG</span>",
        "format-plugged": "BAT: [ {icon} ] <span size='8pt'>PLUG</span>",
        "tooltip-format": "BATTERY: {power}W\nSTATUS: {timeTo}\nCYCLES: {cycles}\nHEALTH: {health}",
        "format-icons": [
            "██░░░░░░", "███░░░░░", "████░░░░",
            "█████░░░", "██████░░", "███████░", "████████"
        ]
    }
}
