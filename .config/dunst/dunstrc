[global]
follow = mouse
width = 400
height = (0, 300)
notification_limit = 3
origin = top-right
offset = (10, 10)
indicate_hidden = true
separator_height = 0
padding = 30
horizontal_padding = 30
frame_width = 2
sort = false
idle_threshold = 0
layer = top
gap_size = 0
font = GeistMono Nerd Font 14
line_height = 4
corner_radius = 4
mouse_middle_click = context
markup = full
icon_position = off
close = ctrl+space
close_all = ctrl+shift+space
history = ctrl+grave
context = ctrl+shift+period
format = "%b\n<small><b>[ %s ]</b></small>"

[urgency_low]
timeout = 4
background = "#0a0a0a"
foreground = "#F2F1F0"
frame_color = "#111111ff"

[urgency_normal]
timeout = 8
background = "#0a0a0a"
foreground = "#F2F1F0"
frame_color = "#111111ff"

[urgency_critical]
timeout = 0
background = "#300000"
foreground = "#F2F1F0"
frame_color = "#111111ff"
